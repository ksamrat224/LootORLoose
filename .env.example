# Public endpoints only. Do not put private keys or signing secrets in this file.
NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc.magicblock.app/devnet
NEXT_PUBLIC_MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app/
# Resolve the ER endpoint from router delegation status at runtime; do not hardcode it.
NEXT_PUBLIC_GAME_PROGRAM_ID=BenkDp3MuSNQshYqTC7PyiWvpBsCQTT5LX6EGYWCQhvj
# Keep disabled until the session-aware program upgrade is deployed and verified on devnet.
NEXT_PUBLIC_GAME_V2_ENABLED=false
# V3 is deployed and verified on devnet (see docs/wager-prototype.md). Set false to hide the wager mode.
NEXT_PUBLIC_WAGER_V3_ENABLED=true
NEXT_PUBLIC_NETWORK=devnet

# V4 independent quests: keep false until the V4 binary and live lifecycle are verified.
NEXT_PUBLIC_QUEST_V4_ENABLED=false

# V5 deployed and verified on devnet Nov 25, 2026; see docs/DEVNET_V5_VERIFICATION.md.
NEXT_PUBLIC_HUNT_V5_ENABLED=true
# V6 creation stays off until the compatible binary and real VRF lifecycle are verified.
NEXT_PUBLIC_HUNT_V6_ENABLED=false
# Session controls upgraded and verified Nov 26, 2026; see docs/DEVNET_SESSION_VERIFICATION.md.
NEXT_PUBLIC_HUNT_SESSION_CONTROL_ENABLED=true
